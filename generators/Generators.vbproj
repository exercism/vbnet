<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionExplicit>On</OptionExplicit>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RootNamespace></RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="Humanizer" />
    <Import Include="System.IO" />
    <Import Include="System.Text" />
    <Import Include="System.Text.Json" />
    <Import Include="System.Text.Json.Nodes" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.3.0" />
    <PackageReference Include="Scriban" Version="7.2.6" />
    <PackageReference Include="Tomlyn" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Generators.Tests\**\*.vb" />
    <Content Include="..\exercises\practice\**" Link="exercises\practice\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\.problem-specifications\exercises\**" Link=".problem-specifications\exercises\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
